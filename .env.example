# Copy this file to .env for local development. Replace values as needed.
# Never put real credentials in this tracked template.
POSTGRES_DB=fikrah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fikrah
REDIS_URL=redis://localhost:6379/0
FIKRAH_CELERY_MAX_RETRIES=3
FIKRAH_CELERY_RETRY_BACKOFF_SECONDS=5
FIKRAH_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
FIKRAH_DISPATCH_STALE_AFTER_SECONDS=300
FIKRAH_PROCESSING_STALE_AFTER_SECONDS=900
FIKRAH_DISPATCH_INTERVAL_SECONDS=30
FIKRAH_DISPATCH_BATCH_SIZE=100
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_NOTES_COLLECTION=fikrah-notes

AI_TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Replace with a private random key of at least 32 characters.
FIKRAH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=

# Email action links must use HTTPS. SMTP settings are needed for email flows.
EMAIL_ACTION_BASE_URL=https://example.invalid/auth/action
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=true
