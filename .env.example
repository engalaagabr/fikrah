# Copy this file to .env for local development. Replace values as needed.
# Never put real credentials in this tracked template.
POSTGRES_DB=fikrah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FIKRAH_POSTGRES_PORT=5432
FIKRAH_REDIS_PORT=6379
FIKRAH_QDRANT_HTTP_PORT=6333
FIKRAH_QDRANT_GRPC_PORT=6334
FIKRAH_API_PORT=8000
FIKRAH_MAILPIT_SMTP_PORT=1025
FIKRAH_MAILPIT_UI_PORT=8025
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:${FIKRAH_POSTGRES_PORT}/fikrah
REDIS_URL=redis://localhost:${FIKRAH_REDIS_PORT}/0
FIKRAH_CELERY_MAX_RETRIES=3
FIKRAH_CELERY_RETRY_BACKOFF_SECONDS=5
FIKRAH_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
FIKRAH_DISPATCH_STALE_AFTER_SECONDS=300
FIKRAH_PROCESSING_STALE_AFTER_SECONDS=900
FIKRAH_DISPATCH_INTERVAL_SECONDS=30
FIKRAH_DISPATCH_BATCH_SIZE=100
QDRANT_URL=http://localhost:${FIKRAH_QDRANT_HTTP_PORT}
QDRANT_API_KEY=
QDRANT_NOTES_COLLECTION=fikrah-notes

LLM_TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Replace with a private random key of at least 32 characters.
FIKRAH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=

# Email action links must use HTTPS. SMTP settings are needed for email flows.
EMAIL_ACTION_BASE_URL=https://example.invalid/auth/action
SMTP_HOST=localhost
SMTP_PORT=${FIKRAH_MAILPIT_SMTP_PORT}
SMTP_FROM=no-reply@fikrah.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
